{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Usage Monitor",
  "version": "0.1.1",
  "identifier": "io.github.stawan15.claude-usage-monitor",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "panel",
        "title": "Claude Usage Monitor",
        "width": 380,
        "height": 600,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Realtime AI coding token usage in your tray",
    "longDescription": "Watches Claude Code, Codex, OpenCode and Gemini CLI logs and shows token usage, estimated cost and plan limits in a Claude Code-styled tray panel.",
    "copyright": "Copyright (c) 2026 stawan15. MIT License.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
